table fact_var_explain
	lineageTag: 01b91784-090f-5a8b-952c-5485180c27de

	measure 'Change in 99% VaR since previous day (GBP m)' = ( CALCULATE ( SUM ( fact_var_explain[value_gbp] ), REMOVEFILTERS ( fact_var_explain ), fact_var_explain[measure] = "VaR99", fact_var_explain[component] = "current" ) - CALCULATE ( SUM ( fact_var_explain[value_gbp] ), REMOVEFILTERS ( fact_var_explain ), fact_var_explain[measure] = "VaR99", fact_var_explain[component] = "previous" ) ) / 1e6
		formatString: +#,0.00;-#,0.00;0.00
		lineageTag: 0968ed84-3fe9-5637-9eb3-30c9d7428591

	measure 'Change by cause (GBP m)' = CALCULATE ( SUM ( fact_var_explain[value_gbp] ), fact_var_explain[measure] = "VaR99", fact_var_explain[component] IN { "positions", "levels", "window" } ) / 1e6
		formatString: +#,0.00;-#,0.00;0.00
		lineageTag: eab72947-f87b-5049-896a-36347f2fd56e

	column 'date'
		dataType: dateTime
		formatString: d mmm yyyy
		lineageTag: ab26405f-4e44-58e9-b01a-9a60c6edded5
		summarizeBy: none
		sourceColumn: date

		annotation SummarizationSetBy = User

	column 'prev_date'
