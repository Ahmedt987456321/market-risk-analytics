	column 'component'
		dataType: string
		lineageTag: 6bdb7342-1b29-50ed-b221-a3718e4f0368
		summarizeBy: none
		sourceColumn: component

		annotation SummarizationSetBy = User

	column 'value_gbp'
		dataType: double
		lineageTag: 262144d5-4551-5623-9d31-5bd324e61bde
