table dim_desk
	lineageTag: 2838b082-5058-53b8-be01-200e93a806cf

	column 'desk'
		dataType: string
		lineageTag: e2552295-894e-5b2d-b98b-4eb5d0267cd2
		summarizeBy: none
		sourceColumn: desk

		annotation SummarizationSetBy = User

	partition dim_desk = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(BiFolder & "dim_desk.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"desk", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
