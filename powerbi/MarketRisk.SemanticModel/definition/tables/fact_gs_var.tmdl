	partition fact_gs_var = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(BiFolder & "fact_gs_var.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"accession", type text}, {"form", type text}, {"filed", type date}, {"period_end", type date}, {"measure", type text}, {"horizon", type text}, {"column", Int64.Type}, {"interest_rates", type number}, {"equity_prices", type number}, {"currency_rates", type number}, {"commodity_prices", type number}, {"diversification", type number}, {"total", type number}, {"identity_gap", type number}}, "en-US")
				in
