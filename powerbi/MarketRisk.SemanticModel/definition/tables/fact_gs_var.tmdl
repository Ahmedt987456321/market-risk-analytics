table fact_gs_var
	lineageTag: e1546e53-4a12-527a-9c2b-465fa2a3cf6b

	measure 'Total VaR (USD m)' = CALCULATE ( SUM ( fact_gs_var[total] ), fact_gs_var[measure] = "average", fact_gs_var[horizon] = "quarter" )
		formatString: 0
		lineageTag: d7407c00-d809-5379-a937-d2375ac67cea

	measure 'Interest rates (USD m)' = CALCULATE ( SUM ( fact_gs_var[interest_rates] ), fact_gs_var[measure] = "average", fact_gs_var[horizon] = "quarter" )
		formatString: 0
		lineageTag: 93627124-4b22-55a7-94e5-496f6cf9ba36

	measure 'Equity prices (USD m)' = CALCULATE ( SUM ( fact_gs_var[equity_prices] ), fact_gs_var[measure] = "average", fact_gs_var[horizon] = "quarter" )
		formatString: 0
		lineageTag: 47fab326-3983-58c2-805b-f626fe3c6575

	measure 'Currency rates (USD m)' = CALCULATE ( SUM ( fact_gs_var[currency_rates] ), fact_gs_var[measure] = "average", fact_gs_var[horizon] = "quarter" )
		formatString: 0
		lineageTag: 6c951e51-99ce-5324-a6f8-4439c26a36bb

	measure 'Commodity prices (USD m)' = CALCULATE ( SUM ( fact_gs_var[commodity_prices] ), fact_gs_var[measure] = "average", fact_gs_var[horizon] = "quarter" )
		formatString: 0
		lineageTag: ffc295d8-47e3-51c8-a746-fffeed917a9b

	measure 'Latest quarter, total (USD m)' = VAR d = CALCULATE ( MAX ( fact_gs_var[period_end] ), fact_gs_var[measure] = "average", fact_gs_var[horizon] = "quarter" ) RETURN CALCULATE ( SUM ( fact_gs_var[total] ), fact_gs_var[measure] = "average", fact_gs_var[horizon] = "quarter", fact_gs_var[period_end] = d )
		formatString: 0
		lineageTag: 7d6c820e-56f3-5f87-970a-dbe01f9b8a0e

	measure 'Quarters published' = CALCULATE ( COUNTROWS ( fact_gs_var ), fact_gs_var[measure] = "average", fact_gs_var[horizon] = "quarter" )
		formatString: 0
		lineageTag: 02ac752c-afcb-50c3-b10a-9b543c00c24e

